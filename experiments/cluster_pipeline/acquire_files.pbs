#!/bin/bash
#PBS -N CERA_CPSC_files
#PBS -q cpuq
#PBS -l select=1:ncpus=4:mem=8gb:ngpus=0
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail
cd ${CERA_ROOT:-$HOME/cera_cpd}
exec >logs/acquisition_files_live.log 2>&1
export OMP_NUM_THREADS=4
${CERA_PY:-python} software/acquire_files.py --output data/cpsc2021/files --workers 8
